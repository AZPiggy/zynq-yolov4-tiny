# ============================================================================
#  Vivado / Vitis / HLS generated output
#  Everything here is reproducible from the scripts in */scripts/.
# ============================================================================

# --- Vivado project working directories -------------------------------------
vivado_prj/acc_project/acc_project.cache/
vivado_prj/acc_project/acc_project.runs/
vivado_prj/acc_project/acc_project.hw/
vivado_prj/acc_project/acc_project.sim/
vivado_prj/acc_project/acc_project.ip_user_files/
vivado_prj/acc_project/acc_project.gen/

# --- Block-design output products (regenerated by `generate_target all`) -----
# Only design_1.bd and the HDL wrapper are real sources.
vivado_prj/acc_project/acc_project.srcs/sources_1/bd/design_1/ip/
vivado_prj/acc_project/acc_project.srcs/sources_1/bd/design_1/ipshared/
vivado_prj/acc_project/acc_project.srcs/sources_1/bd/design_1/sim/
vivado_prj/acc_project/acc_project.srcs/sources_1/bd/design_1/synth/
vivado_prj/acc_project/acc_project.srcs/sources_1/bd/design_1/ui/
vivado_prj/acc_project/acc_project.srcs/utils_1/

# --- Hardware build outputs (bitstream / XSA / reports) ---------------------
# Rebuild with vivado_prj/scripts/build_hardware.tcl, or grab from a Release.
vivado_prj/output/*.bit
vivado_prj/output/*.xsa
vivado_prj/output/*.dcp
vivado_prj/output/*.rpt
vivado_prj/output/*.txt

# --- Vitis workspaces (regenerated by vitis_prj/scripts/build_platform.tcl) --
vitis_prj/workspace/
vitis_prj/workspace_mindc/

# --- Firmware build outputs -------------------------------------------------
vitis_prj/output/*.o
vitis_prj/output/*.elf
vitis_prj/output/*.map
vitis_prj/boot/BOOT.BIN

# --- Vitis HLS solution working directory -----------------------------------
# The exported IP under top/top/solution1/impl/ip/ IS tracked: the Vivado
# block design needs it. Everything else in the solution is intermediate.
hls_prj/top/top/*
!hls_prj/top/top/solution1/
hls_prj/top/top/solution1/*
!hls_prj/top/top/solution1/impl/
hls_prj/top/top/solution1/impl/*
!hls_prj/top/top/solution1/impl/ip/

# ============================================================================
#  Model weights (large binaries — see README "Weights" for how to get them)
# ============================================================================
*.pth
*.bin
!vitis_prj/boot/*.bif
yolov4_tiny_weights/
tools/predictor/folded_weights/

# Legacy duplicate of tools/predictor (contains its own nested .git)
yolo4_tiny_bn_fold/

# ============================================================================
#  Historical snapshots — not part of the buildable project
# ============================================================================
archive/

# ============================================================================
#  Tool state, logs, scratch
# ============================================================================
.Xil/
**/.Xil/
*.jou
*.log
*.str
*.wdb
*.pb
webtalk*
.analytics
.metadata/
RemoteSystemsTempFiles/
IDE.log
tmp/
-p/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- Editors / OS -----------------------------------------------------------
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
